{
  "name": "inox",
  "version": "0.4.0",
  "description": "The Inox programming language.",
  "type": "module",
  "main": "builds/inox.js",
  "bin": {
    "inox": "bin/inox.js"
  },
  "directories": {
    "lib": "lib",
    "builds": "builds",
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "probe:spec-runtime-audit": "node scripts/probe-spec-runtime-audit.js",
    "build:src": "tsc -p tsconfig.src.json",
    "run": "tsc && node --enable-source-maps builds/inox.js",
    "replit": "tsc&& node builds/inox.js",
    "serve": "node bin/inox-serve.js",
    "test:serve": "node scripts/test-inox-serve.js",
    "test:retrieval": "node scripts/test-retrieval-batch.js",
    "test:continuations": "node scripts/test-serve-continuations.js",
    "bench:serve": "node scripts/bench-inox-serve.js",
    "test:session": "node scripts/test-session-packets.js",
    "test:shutdown": "node scripts/test-pool-shutdown.js",
    "test:micro:host-image": "node --test tools/inox-image/test.mjs",
    "test:cli-eval": "node scripts/test-cli-eval.js",
    "test:l9": "node scripts/test-l9-bootstrap.js",
    "test:loop-control": "node scripts/test-loop-control.js",
    "test:stack-growth-threshold": "node scripts/test-stack-growth-threshold.js",
    "test:actor-stack-relocation": "node scripts/test-actor-stack-relocation.js",
    "test:l9-tasks": "node scripts/test-l9-task-structure.js",
    "test:l9-lifecycle-basics": "node scripts/test-l9-lifecycle-basics.js",
    "test:l9-mutex": "node scripts/test-l9-mutex.js",
    "test:l9-lock": "node scripts/test-l9-lock.js",
    "test:l9-boxon": "node scripts/test-l9-boxon.js",
    "test:l9-parole": "node scripts/test-l9-parole.js",
    "test:l9-parole-template": "node scripts/test-l9-parole-template.js",
    "test:l9-semaphore": "node scripts/test-l9-semaphore.js",
    "test:l9-signal": "node scripts/test-l9-signal.js",
    "test:l9-promise-chain": "node scripts/test-l9-promise-chain.js",
    "test:l9-actor-layout": "node scripts/test-l9-actor-layout.js",
    "test:l9-actor-switch": "node scripts/test-l9-actor-switch.js",
    "test:l9-object-core": "node scripts/test-l9-object-core.js",
    "test:l9-ready-queue": "node scripts/test-l9-ready-queue.js",
    "test:l9-error-delivery": "node scripts/test-l9-error-delivery.js",
    "test:l9-join": "node scripts/test-l9-join.js",
    "test:inox-guarded-exceptions": "node scripts/test-inox-guarded-exceptions.js",
    "test:inox-try-finally": "node scripts/test-inox-try-finally.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virteal/Inox.git"
  },
  "keywords": [
    "wasm"
  ],
  "author": "Jean Hugues Noel ROBERT",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/virteal/Inox/issues"
  },
  "homepage": "https://github.com/virteal/Inox#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
