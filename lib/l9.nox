~~ #2026: Old code was: . global: classes/ is: map[] :classes;
global: classes/ is: map[] :classes;


to classes.get  classes .?@

to method-text-name  >method >class
  ( $class & "." & $method )

to method-name  method-text-name as-tag

~~ #2026: parameter was added in 2026
to parameter  parameters. inline

to define-method  with class/ method/ code/ parameters
  define-verb( method-name( $class, $method ), $code )

~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
~~ Resolve a method through the canonical class/superclass metadata, without
~~ invoking its body. Used both by fallback dispatch and `understand?`.
~~ A subclass method takes precedence; a missing root method yields void.
to resolve-method-name  >method >class
  $class >cursor
  _ >resolved-name
  while: { $cursor something? } do: {
    method-name( $cursor, $method ) >candidate
    if: verb.exist?( $candidate ) then: {
      $candidate >resolved-name!
      break
    };
    $cursor classes.get >meta
    break-if( $meta nothing? )
    superclass-name/ $meta object.?@ >parent-name
    break-if( $parent-name nothing? )
    break-if( $parent-name = $cursor )
    $parent-name >cursor!
  };
  $resolved-name

~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
~~ The *same* resolver serves dispatch and reflection: do not execute a
~~ candidate method just to answer `understand?`.
to understand?  >method >target
  class-of( $target ) >class-name
  resolve-method-name( $class-name, $method ) something?

~~ Method dispatch places the receiver last; the standalone helper accepts
~~ (target, method). Reorder only at this method adapter.
to thing.understand?  swap understand?

to make{ >make-code >it
  with
    $make-code run
  ~~ #2026: Old code was: with-length{ make.object( it rename ) }
  ~~ Objects are extensible by default (correctness first): methods/attributes
  ~~ can always be added later, e.g. thing's on-the-fly class extension. Build
  ~~ the populated object then extend it in place (extend-object consumes one
  ~~ reference and mutates the shared area, leaving an extensible object). A
  ~~ future compaction verb will opt into the faster fixed layout where proven.
  with-length{ make.object( it rename ) duplicate extend-object }

to make.metaclass  >class-name
  ~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
  ~~ update-class() rebuilds metaclasses. Preserve the declared superclass
  ~~ rather than silently resetting every class to /thing on each refresh.
  $class-name classes.get >previous-meta
  /thing >parent-tag
  if: $previous-meta something? then: {
    superclass-name/ $previous-meta object.?@ >existing-parent
    if: $existing-parent something? then: { $existing-parent >parent-tag! };
  };
  metaclass/make{
    $class-name :name
    map[]       :definitions
    map[]       :class-definitions
    map[]       :attributes
    /metaclass  :class
    $parent-tag :superclass-name
  } >metaclass
  ~~ #2026: Old code was: $metaclass $class-name classes debugger .!
  $metaclass $class-name classes .!
  $metaclass

to update-classes  >pattern
  definitions >definitions
  $definitions .each{ >full-name
    text.find( $full-name, "." ) >dot-index
    break-if( $dot-index nothing? )
    $full-name .cut( $dot-index ) as-tag >class-name
    break-unless( $class-name in? classes  )
    break-unless( $pattern = "*"  or{ ( $class-name = $pattern ) } )
    make.metaclass( $class-name )
  }
  if: ( $pattern = "*" ) then: {
    clear-method-cache( all/, all/ )
  } else: {
    clear-method-cache( $pattern as-tag, all/ )
  };

to update-all-classes  update-classes( "*" )
to update-class        update-classes

~~ #2026: Old code was:
~~ to extend-class{  with class-name/ code/ parameters
~~   assert{ verb.exist?( $class-name ) }
~~   $class-name >it
~~   return-unless( it in? classes )
~~   update-class( it )
~~   $code .run
~~   update-class( it )
to extend-class{  with class-name/ code/ parameters
  if: verb.exist?( $class-name ) then: {
    $class-name >it
    _ >class-superclass
    ~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
    ~~ A pre-existing verb can be the implementation of a class (thing, map)
    ~~ without an entry in the classes registry. `in? classes` performs
    ~~ dynamic method dispatch and is not a reliable existence probe here.
    ~~ Register its metaclass without replacing the pre-existing verb.
    if: ( it classes.get something? ) then: {
      update-class( it )
      $code .run
      update-class( it )
    } else: {
      make.metaclass( it ) drop
      $code .run
      update-class( it )
    };
  } else: {
    "extend-class: class not exist? " out $class-name out "\n" out
  };

~~ #2026: Old code was:
~~ to class{  with class-name/ code/ parameters
~~   verb.exist?( $class-name ) then{
~~     $class-name extend-class{ $code run }
~~     return
~~   }
~~   assert{ verb.exist?( $class-name ) not }
~~   $class-name >it
~~   make.metaclass( it ) >metaclass
~~   define-method(  it, /class, attach( it, {} ) )
~~   classes.get( thing/ ) >class-superclass
~~   define-method( it, /superclass, attach( $class-superclass, {} ) )
~~   update-class(  it )
~~   $code .run
~~   define-method( it, /superclass, attach( $class-superclass, {} ) )
~~   define-verb(   it, attach( $class-superclass .name as-verb, {} ) )
~~   update-class(  it )
to class{  with class-name/ code/ parameters
  if: verb.exist?( $class-name ) then: {
    ~~ 2026-11-22: GPT-6 coding agent, under Jean Hugues Noel Robert.
    ~~ Preserve the outer code block before extend-class{ introduces its own
    ~~ dynamically scoped `code`, otherwise the inner block runs itself.
    $code >outer-code
    $class-name extend-class{ $outer-code run }
  } else: {
    $class-name >it
    make.metaclass( it ) >metaclass
    define-method(  it, /class, attach( it, {} ) )
    classes.get( thing/ ) >class-superclass
    define-method( it, /superclass, attach( $class-superclass, {} ) )
    update-class(  it )
    $code .run
    define-method( it, /superclass, attach( $class-superclass, {} ) )
    ~~ A root class defined before its superclass is registered (e.g. metaclass
    ~~ before thing) has a void class-superclass; skip the superclass-named verb
    ~~ then ( $class-superclass .name would dispatch .name on void ).
    if: $class-superclass something? then: {
      define-verb( it, attach( $class-superclass .name as-verb, {} ) )
    };
    update-class(  it )
  };

to superclass  >parent-tag
  ~~ 2026-11-24: GPT-6 under Jean Hugues Noel Robert. Both the active
  ~~ class builder and its persisted metaclass must agree on inheritance.
  $parent-tag classes.get >class-superclass!
  $parent-tag it classes.get superclass-name/ object.!

to maker{  >code
  define-method( make/, it, attach( it, $code ) )

to class-method{  with name/ code/ parameters
  define-method( it, $name, $code )

to method{  with name/ code/ parameters
  define-method( it, $name, $code )

~~ ToDo: alias-method

to it-method{  with name/ code/ parameters
  attach( $code, { run-with-it } ) >bounded-code
  define-method( it, $name, $bounded-code )

to class-attribute  >attribute-name
  make.global( method-name( it, $attribute-name ), _ )

to attribute  >name
  attach( $name, { object.@ } ) >getter
  define-method( it, $name, $getter )
  attach( $name, { object.! } ) >setter
  define-method( it, $name & /!, $setter )

to getter  attribute
to setter  attribute

~~ Synchronous fallback for methods not defined on the receiver class.
~~ Cache the inherited definition for future dispatch, and execute it before
~~ returning to the caller (not via a delayed post-caller continuation).
to thing  >method >class
  resolve-method-name( $class, $method ) >resolved-name
  if: $resolved-name something? then: {
    $resolved-name as-verb definition >definition-address
    update-method-cache( $class, $method, $definition-address )
    $resolved-name as-verb run
  } else: {
    ~~ Keep absent methods observable rather than silently succeeding.
    ~~ ToDo (2026-11-24, GPT-6): the legacy missing-method hook can emit
    ~~ a nested-scope Invalid boolean assertion after its useful diagnostic.
    ~~ Repair that general error-unwind mechanism separately.
    method-text-name( $class, $method ) missing-method
  };

to map  thing

~~ Provide map.contain? (and potentially others like for set) so that during
~~ class/metaclass setup (make.metaclass, update-class, define-method etc which
~~ may do "definitions contain? foo" or similar on map instances), the "thing"
~~ lookup finds it via dotted name on-the-fly instead of falling to unknown
~~ method which triggers run-super-method with non-int on TOS (the FATAL).
~~ #2026: map.contain? was added in 2026
to map.contain?  >map >key   $key $map map.get something? .

to initialize-classes
  metaclass/class{
    thing/superclass
    name/getter
    methods/getter
    class-methods/getter
  }
  void/class{              void/superclass        }
  thing/class{             void/superclass        }
    value/class{           thing/superclass       }
      boolean/class{       value/superclass       }
      tag/class{           value/superclass       }
      number/class{        value/superclass       }
      integer/class{       number/superclass      }
      float/class{         number/superclass      }
      text/class{          value/superclass       }
      runnable/class{      value/superclass       }
        verb/class{        runnable/superclass    }
        primitive/class{   runnable/superclass    }
    object/class{          thing/superclass       }
      native/class{        object/superclass      }
      proxy/class{         object/superclass      }
      block/class{         object/superclass      }
      collection/class{    object/superclass      }
        array/class{       collection/superclass  }
        list/class{        collection/superclass  }
        stack/class{       collection/superclass  }
        queue/class{       collection/superclass  }
        set/class{         collection/superclass  }
          map/class{       set/superclass         }
  update-all-classes
initialize-classes


global: l9-next-id/      is: 0;
global: l9-root/         is: _;
~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
~~ The VM-local registry OWNS task references; actor slot #7 contains only
~~ the immutable task id. The task owns its actor. This breaks the actor/task
~~ reference cycle and avoids raw weak pointers to movable/freed VM cells.
~~ Terminal tasks are unregistered on normal exit/failure; parent retains
~~ completed children for join/introspection. Later supervision must define
~~ when/how to release those parent-owned histories.
global: l9-task-registry/ is: array[];
~~ The ready queue is local to THIS interpreter/VM, not a global COP queue.
global: l9-ready-queue/   is: queue[];

~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
~~ One canonical registry release operation shared by both normal completion
~~ and fail-early task delivery. Stable task IDs remain; entries become void.
to l9-unregister-task  >task-id
  l9-task-registry $task-id 1 - _ array.put

~~ Full-L9 public task lookup shadows the VM's raw slot-reader primitive.
~~ actor is a typed, owning reference; stack index 6 is payload slot #7.
to l9
  6 actor stack.fetch >task-id
  if: ( $task-id > 0 ) then: {
    $task-id 1 - l9-task-registry array.get
  } else: { _ };

~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
~~ FIFO dispatcher-selection boundary: pick the oldest eligible task, discard
~~ stale paused/canceled/done entries. Dequeue clears queued? before return.
~~ This DOES NOT switch the VM registers. task.yield/context switching is a
~~ separate boundary, verified only when two real actors can execute.
to l9-next-ready
  _ >selected
  while: { l9-ready-queue queue.length 0 > } do: {
    l9-ready-queue queue.pull >candidate
    false $candidate queued?/ object.!
    ~~ Pending exceptions are selected even when the actor is paused or
    ~~ canceled. Selection itself does NOT complete the task or discard its
    ~~ finalizers; l9-dispatch-next restores its own VM context before raising.
    if: ( $candidate pending-error?/ object.@ ) then: {
      $candidate >selected!
      break
    } else: {
      if: ( $candidate paused?/ object.@ not ) then: {
        if: ( $candidate done?/ object.@ not ) then: {
          if: ( $candidate canceled?/ object.@ ) then: {
            if: ( $candidate unwinding?/ object.@ ) then: {
              $candidate >selected!
              break
            } else: {
              if: ( $candidate joining?/ object.@ ) then: {
                $candidate >selected!
                break
              };
            };
          } else: {
            $candidate >selected!
            break
          };
        };
      };
    };
  };
  $selected

~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
~~ Cooperative dispatch boundary: select the next task and switch IP/TOS/CSP.
~~ Pending exceptions enter the target actor's own VM guard/finally machinery.
~~ The running task must yield/reschedule explicitly for another turn.
~~ There is no background preemption; no central COP scheduler is involved.
to l9-dispatch-next
  ~~ When another task is ready, a runnable current task yields its turn but
  ~~ stays eligible for a future turn. Paused/done tasks are not requeued.
  if: ( l9-ready-queue queue.length 0 > ) then: {
    l9 >current-task
    ~~ A terminating actor is unregistered before dispatch and has no task
    ~~ object in the active registry. Do not invoke .schedule on void.
    if: $current-task something? then: { $current-task .schedule };
  };
  l9-next-ready >next-task
  return-if( $next-task nothing? )
  if: ( $next-task .pending-error? ) then: {
    $next-task .error >reason
    _ $next-task error/ object.!
    false $next-task pending-error?/ object.!
    true $next-task unwinding?/ object.!
    $reason $next-task .actor switch-actor-raise
  } else: {
    $next-task .actor switch-actor
  };

~~ 2026-11-24: GPT-6 under Jean Hugues Robert. Shared terminal lifecycle.
~~ Reached from the actor's initial return sentinel or from an unhandled
~~ language exception after the VM has unwound all active scope finalizers.
~~ This is NOT a public Task method: only the owning actor calls it after
~~ ordinary return or a VM-level unhandled exception has unwound its scopes.
~~ All callbacks run with the Task's actor and VM pin still alive. They may
~~ yield; only after their return do we mark done and detach the actor.
to l9-complete-current
  l9 >finished
  return-if( $finished nothing? )
  return-if( $finished done?/ object.@ )
  return-if( $finished finalizing?/ object.@ )
  true $finished finalizing?/ object.!
  true $finished defer-phase?/ object.!
  $finished deferred-task-hooks/ object.@ >deferred
  while: { $deferred array.length 0 > } do: {
    $deferred array.pop >cleanup
    { $cleanup .run }
    { >reason $reason $finished error/ object.! }
    run-guarded
  };
  false $finished defer-phase?/ object.!
  $finished error/ object.@ >failure-reason
  if: $failure-reason something? then: {
    $finished failure-hook/ object.@ >hook
    if: $hook something? then: {
      { $hook .run( $finished error/ object.@ )
        _ $finished error/ object.!
      }
      { >reason $reason $finished error/ object.! }
      run-guarded
    };
  } else: {
    $finished success-hook/ object.@ >hook
    if: $hook something? then: {
      { $hook .run( $finished result/ object.@ ) }
      { >reason $reason $finished error/ object.! }
      run-guarded
    };
  };
  $finished final-hook/ object.@ >hook
  if: $hook something? then: {
    { $hook .run( $finished error/ object.@ $finished result/ object.@ ) }
    { >reason $reason $finished error/ object.! }
    run-guarded
  };
  ~~ Drop callback-owning references: the parent may keep this Task for
  ~~ joining/introspection, but that must not retain captured resources.
  _ $finished deferred-task-hooks/ object.!
  _ $finished failure-hook/ object.!
  _ $finished success-hook/ object.!
  _ $finished final-hook/ object.!
  ~~ A callback may have yielded; keep these state transitions LAST.
  true $finished done?/ object.!
  false $finished finalizing?/ object.!
  false $finished pending-error?/ object.!
  false $finished exiting?/ object.!
  false $finished unwinding?/ object.!
  true $finished paused?/ object.!
  false $finished queued?/ object.!
  $finished .parent >parent-task
  if: $parent-task something? then: {
    ~~ A completed parent may leave live descendants. Transfer ownership and
    ~~ active-child accounting to the grandparent before declaring it done.
    $finished subtasks/ object.@ >descendants
    0 >idx
    while: { $idx $descendants array.length < } do: {
      $idx $descendants array.get >descendant
      $parent-task subtasks/ object.@ $descendant array.push
      $parent-task .id $descendant parent-id/ object.!
      if: ( $descendant done?/ object.@ not ) then: {
        $parent-task pending-children/ object.@ 1 + $parent-task pending-children/ object.!
      };
      if: ( $descendant a-fork?/ object.@ ) then: {
        $parent-task forks/ object.@ $descendant array.push
      };
      $idx 1 + >idx!
    };
    array[] $finished subtasks/ object.!
    array[] $finished forks/ object.!
    array[] $finished failed-children/ object.!
    if: ( $finished error/ object.@ something? ) then: {
      $parent-task failed-children/ object.@ $finished array.push
    };
    $parent-task pending-children/ object.@ 1 - $parent-task pending-children/ object.!
    if: ( $parent-task joining?/ object.@ ) then: {
      if: ( $parent-task pending-children/ object.@ 0 = ) then: {
        ~~ Keep joining? set until the awakened parent resumes its join
        ~~ continuation; canceled parents must remain scheduler-eligible.
        $parent-task .resume
      };
    };
  };
  ~~ Task.result/error/history survive; the actor and both stacks do not.
  ~~ ACTOR has its own temporary VM pin until the following switch.
  _ $finished actor/ object.!
  $finished .id l9-unregister-task

to l9-actor-finish
  l9-complete-current
  l9-dispatch-next
  halt-actor

~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
~~ VM entry after an unhandled language error in a child actor. Its control
~~ frames and finalizers have ALREADY been unwound; the original typed reason
~~ is the sole data-stack argument. Record this terminal failure exactly once,
~~ notify the parent, unregister the task, then dispatch another actor. Do NOT
~~ inject the same error again into the exhausted child continuation.
to l9-uncaught-error
  >reason
  l9 >failed-task
  if: $failed-task something? then: {
    $reason $failed-task error/ object.!
    ~~ The exception has already entered the actor. Do not leave its
    ~~ transport flag set while failure/final callbacks may yield.
    false $failed-task pending-error?/ object.!
    l9-complete-current
    l9-dispatch-next
    halt-actor
  };
  $reason FATAL

~~ 2026-11-23 GPT-6 under Jean Hugues Noel Robert: no early make.task stub.
~~ The actual task maker is registered by task/class{ during initialize-l9.

~~ Shallow snapshot of the result vector, not of its payload objects.
to outcome-copy-values
  >source array[] >copy 0 >idx
  while: { $idx $source array.length < } do: {
    $copy $idx $source array.get array.push
    $idx ++ >idx!
  };
  $copy

to initialize-l9

  promise-handler/class{
    maker{
      make{
        _ :next-promise
        _ :on-resolve
        _ :on-reject
      }
    }
    ~~ 2026-11-23: GPT-6 coding agent under Jean Hugues Noel Robert.
    ~~ Deliver the settled source to the handler; settle the *next* promise
    ~~ with the returned callback value or propagate unchanged if absent.
    ~~ 2026-11-24: GPT-6 coding agent under Jean Hugues Noel Robert.
    ~~ The VM's actor-local run-guarded boundary now translates callback
    ~~ language errors into rejections of the dependent promise. The same
    ~~ vm-raise mechanism is reusable for task/step exception delivery.
    ~~ Non-callback pass-through keeps the original settlement semantics.
    schedule/it-method{ >source
      @next-promise >next
      if: $source .resolved? then: {
        if: @on-resolve something? then: {
          { @on-resolve .run( $source resolve-value/ object.@ ) $next .resolve }
          { >failure $failure $next .reject }
          run-guarded
        } else: {
          $source resolve-value/ object.@ $next .resolve
        };
      } else: {
        if: @on-reject something? then: {
          { @on-reject .run( $source reject-reason/ object.@ ) $next .resolve }
          { >failure $failure $next .reject }
          run-guarded
        } else: {
          $source reject-reason/ object.@ $next .reject
        };
      };
    }
  }

  promise/class{
    maker{
      make{
        false  :resolved?
