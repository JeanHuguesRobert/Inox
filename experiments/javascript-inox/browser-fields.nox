to sensitive-field? "username|password|one-time-code|cc-number|cc-csc" text.matches-i? .
to eligible-field swap dup "tag" get "input" equal? swap dup "type" get 3 pick equal? swap dup "disabled" get false equal? swap dup "readonly" get false equal? swap "autocomplete" get sensitive-field? not and and and and swap drop .
to first-field
  0
  while: { dup count < } do: {
    dup field 2 pick eligible-field break-if
    1 +
  };
  dup count equal? { drop -1 } if
  swap drop.
