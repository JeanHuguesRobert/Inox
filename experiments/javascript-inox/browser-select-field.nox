to sensitive-field? "username|password|one-time-code|cc-number|cc-csc" text.matches-i?.

~~ A single selector with explicit first/unique policy.
~~ ZeroBrowser projects only observed, non-value field metadata.
to eligible-editor? >wanted-role >field
  /editable $field object.?@ true equal?
  /disabled $field object.?@ false equal? and
  /readonly $field object.?@ false equal? and
  /autocomplete $field object.?@ sensitive-field? not and
  $wanted-role "" equal? not /semantic_role $field object.?@ $wanted-role equal? not and not and.

to select-editable >wanted-role >selection
  -1 >selected
  0 >index
  while: { $index count < } do: {
    if: $index field.object $wanted-role eligible-editor? then: {
      if: $selected -1 equal? not then: {
        -2 >selected!
        break
      };
      $index >selected!
      $selection "first" equal? break-if
    };
    $index 1 + >index!
  };
  $selected.

~~ Pure intent: the Core binds the observed index to the element identity.
~~ No effect is performed by the short-lived VM.
to plan-text-edit >operation
  select-editable >index
  $index :index
  $operation :operation
  3 :text-edit make.object.
